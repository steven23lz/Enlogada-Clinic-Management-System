# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings (Local PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enlogada_clinic

# Security Settings
JWT_SECRET=supersecretkeyreplaceinproduction
JWT_EXPIRES_IN=7d

# Email Settings (Gmail SMTP for sending released diagnostics results)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Enlogada Clinic <noreply@enlogadaclinic.com>

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
